# Copie para .env.local e preencha com as chaves do projeto lesstax-dev.
# O .env.local nunca vai para o repositório (já está no .gitignore).

# Endereço do app (usado nos links dos e-mails de confirmação e recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # só no servidor: ignora a RLS

# Painel /admin — e-mails com acesso, separados por vírgula (e-mail precisa estar confirmado)
ADMIN_EMAILS=

# Lessy — platform.claude.com
ANTHROPIC_API_KEY=
LESSY_MODEL=claude-sonnet-5
LESSY_MAX_GRATUITO=3     # perguntas por mês, plano gratuito
LESSY_MAX_MES_PAGO=100   # perguntas por mês, plano pago
LESSY_MAX_DIA=400        # teto geral por dia

# Consulta de CNPJ (BrasilAPI, sem chave)
CNPJ_MAX_IP=20
CNPJ_MAX_DIA=500
